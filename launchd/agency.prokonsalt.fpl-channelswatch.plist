<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Template: launchd/install.sh renders YOUR_USERNAME paths to this checkout.
       Hourly: new posts from the public channels in FPL_TELEGRAM_CHANNELS -> LMS news notes.
       Reads the t.me/s/ web preview only; no login, no session. -->
  <key>Label</key><string>agency.prokonsalt.fpl-channelswatch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USERNAME/fpl-agent/.venv/bin/python</string>
    <string>-m</string>
    <string>fpl_agent.ops.channelswatch</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/YOUR_USERNAME/fpl-agent</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/YOUR_USERNAME/fpl-agent/logs/channelswatch.log</string>
  <key>StandardErrorPath</key><string>/Users/YOUR_USERNAME/fpl-agent/logs/channelswatch.log</string>
</dict>
</plist>
