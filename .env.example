# ---------------------------------------------------------------------------
# fpl-agent configuration
#
# The ENTIRE read path is public. You do NOT need to log in to Fantasy
# Premier League for anything this project does. There is deliberately no
# credential field here, and no code path that authenticates.
# ---------------------------------------------------------------------------

# Your FPL entry ID — the number in your team URL:
#   https://fantasy.premierleague.com/entry/1234567/event/1
FPL_ENTRY_ID=

# IANA timezone used for every rendered date and kick-off time.
FPL_TIMEZONE=Europe/London

# Planning horizon in gameweeks for the transfer optimiser.
FPL_HORIZON=3

# Per-gameweek discount applied to future expected points (0 < d <= 1).
# Lower values make the optimiser greedier about the current gameweek.
FPL_DECAY=0.85

# HTTP cache lifetime in seconds. Keep this short near a deadline.
FPL_CACHE_TTL=900

# --- Optional: Telegram alerts through a DEDICATED bot ---------------------
# Keep this bot separate from anything that touches money. Create it with
# @BotFather, press /start on it, paste the token here. The user id is the
# number @userinfobot replies with. Alerts are advisory: nothing is entered.
# FPL_TELEGRAM_BOT_TOKEN=
# FPL_TELEGRAM_USER_ID=

# Public Telegram channels to read for team news through the t.me/s/ web
# preview — no login, no session, read-only. Comma-separated handles, no @.
# FPL_TELEGRAM_CHANNELS=

# --- Optional: the local LMS the scheduled jobs sync into --------------------
# Base URL of the LMS (Next.js) that stores history, desks and the vault export.
# The jobs only ever POST to its /api/sports/fpl/* routes.
# FPL_LMS_URL=http://127.0.0.1:3003

# --- Optional: social signals (pip install "fpl-agent[social]") ------------
# Reddit uses the official API. Register a "script" app at
# https://www.reddit.com/prefs/apps — no password is required for read-only.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=fpl-agent/0.1 by u/yourname
